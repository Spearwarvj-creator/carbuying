# Public address of the site, used for the share image, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=

# AI helpers (all optional). Without a key the app still works: Quick fill by voice or text, the checks,
# read aloud, saving, and the standard explanations need no key. Photos, rewording, the Spanish and tone
# options, "ask your own question" and practice need it.
OPENROUTER_API_KEY=
# One model does both jobs (reading photos, and writing a few plain sentences). Use ids exactly as OpenRouter lists
# them. Claude Haiku 5.5 read every field of a test worksheet correctly at about $0.0003 a photo. MODEL_FALLBACK is
# tried only if the main model is down. Thinking is switched off in code, because these jobs only copy and reword.
MODEL_VISION=anthropic/claude-haiku-5.5
MODEL_TEXT=anthropic/claude-haiku-5.5
MODEL_FALLBACK=google/gemini-2.5-flash-lite
# Free AI credits. Each visitor gets DAILY_CREDITS a day (a question, reword or practice turn costs 1, each photo costs 2).
# GLOBAL_DAILY_CREDITS stops the whole service for the day, which caps the spend. They reset at midnight UTC.
DAILY_CREDITS=20
GLOBAL_DAILY_CREDITS=1000
# Boost codes for people who ask for more: "code:extra credits a day", comma separated. Use long random codes.
# Give one by hand to someone who contacts you on YouTube or by email. Leave empty for none.
BOOST_CODES=
# Where people can ask for more (shown when they run out, and in Help). Set at build time.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_YOUTUBE_URL=

# Shared daily limits (optional). Without these the limits are counted in each server's own memory, which is a soft
# brake on serverless hosting. With an Upstash Redis database they hold across every instance. Visitors are stored as a
# one-way hash that changes each day, never as an address.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
